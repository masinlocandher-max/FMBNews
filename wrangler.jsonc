{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fmb-news",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-31",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "www.francinemariebautista.com/news*",
      "zone_name": "francinemariebautista.com"
    },
    {
      "pattern": "francinemariebautista.com/news*",
      "zone_name": "francinemariebautista.com"
    }
  ]
}

# Names only. A value committed here is a published credential.
# Every secret below is SERVER-SIDE: a Cloudflare Worker secret
# (`npx wrangler secret put NAME`) or a CI secret. None of them may ever be
# read by, bundled into, or fetched by browser JavaScript.

# --- in use today -----------------------------------------------------------
# Browser-safe. The publishable key is designed to be public and is protected
# by Supabase Row Level Security, not by secrecy.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# --- prepared boundaries, not yet wired -------------------------------------
# Listed because config/newsroom-integrations have a documented adapter
# boundary in docs/ai-newsroom-integrations.md. Anything without one stays out
# of this file until it has one.

# Drafting and extraction. Server-side only.
OPENAI_API_KEY=

# Narration. Generated once from an approved script, stored, then served as a
# file; the site never calls this at read time, so the key never reaches a
# browser.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Newsletter delivery.
RESEND_API_KEY=
